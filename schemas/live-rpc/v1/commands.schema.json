{
  "$defs": {
    "AgentMode": {
      "enum": [
        "build",
        "plan"
      ],
      "type": "string"
    },
    "ApprovalCommand": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "approved": {
                "const": false
              }
            },
            "required": [
              "approved"
            ]
          },
          "then": {
            "not": {
              "required": [
                "scope"
              ]
            }
          }
        }
      ],
      "description": "Resolve a pending tool approval request.",
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            }
          ],
          "title": "Reason"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalScope"
            }
          ]
        },
        "type": {
          "const": "approval",
          "default": "approval",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "call_id",
        "approved"
      ],
      "title": "ApprovalCommand",
      "type": "object"
    },
    "ApprovalScope": {
      "enum": [
        "once",
        "tool_session",
        "all_session"
      ],
      "type": "string"
    },
