    "GetMessagesCommand": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "before_entry_id",
              "after_entry_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "entry_ids"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "before_entry_id"
                  ]
                },
                {
                  "required": [
                    "after_entry_id"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "full_content": {
                "const": true
              }
            },
            "required": [
              "full_content"
            ]
          },
          "then": {
            "properties": {
              "entry_ids": {
                "maxItems": 1,
                "minItems": 1
              }
            },
            "required": [
              "entry_ids"
            ]
          }
        }
      ],
      "description": "Return a bounded persisted transcript page.",
      "properties": {
        "after_entry_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "After Entry Id"
        },
        "allow_during_prompt": {
          "anyOf": [
            {
              "type": "boolean"
            }
          ],
          "title": "Allow During Prompt"
        },
        "before_entry_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Before Entry Id"
        },
        "complete_structure": {
          "anyOf": [
            {
              "type": "boolean"
            }
          ],
          "title": "Complete Structure"
        },
        "entry_ids": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ],
          "title": "Entry Ids"
        },
        "full_content": {
          "anyOf": [
            {
              "type": "boolean"
            }
          ],
          "title": "Full Content"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Id"
        },
        "limit": {
          "default": 200,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Session Id"
        },
        "type": {
          "const": "get_messages",
          "default": "get_messages",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "limit"
      ],
      "title": "GetMessagesCommand",
      "type": "object"
    },
