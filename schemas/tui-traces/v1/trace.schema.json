                  "type": {
                    "const": "queue.message.injected"
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "content"
                ]
              }
            }
          ],
          "required": [
            "type"
          ],
          "x-wisp-max-depth": 8,
          "x-wisp-max-nodes": 1024
        },
        "type": {
          "const": "rpc.event",
          "default": "rpc.event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
