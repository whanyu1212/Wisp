{
  "schema_version": 1,
  "name": "prompt_stream_completion",
  "description": "Submit a prompt and receive streamed deltas and completion.",
  "initial": {
    "provider": "fake",
    "model": null,
    "effort": null,
    "view": null,
    "interaction": null
  },
  "inputs": [
    {
      "type": "local.submit",
      "content": "hello world",
      "clock_ms": 0
    },
    {
      "type": "rpc.event",
      "event": {
        "type": "message.started",
        "turn": 1
      },
      "clock_ms": 10
    },
    {
      "type": "rpc.event",
      "event": {
        "type": "message.delta",
        "turn": 1,
        "delta": "hello"
      },
      "clock_ms": 20
    },
    {
      "type": "rpc.event",
      "event": {
        "type": "message.delta",
        "turn": 1,
        "delta": " world"
      },
      "clock_ms": 30
    },
    {
      "type": "rpc.event",
      "event": {
        "type": "message.completed",
        "turn": 1,
        "content": "hello world",
        "finish_reason": "stop"
      },
      "clock_ms": 40
    },
    {
      "type": "rpc.event",
      "event": {
        "type": "rpc.command.finished",
        "command_id": "prompt-1",
        "command_type": "prompt",
        "ok": true
      },
      "clock_ms": 50
    }
  ],
  "expected": {
    "commands": [
      {
        "type": "prompt",
        "id": "prompt-1"
      },
      {
        "type": "get_session_stats",
        "id": "get_session_stats-1"
      }
    ],
    "view": {
      "status": "idle",
      "input_mode": "idle",
      "input_ready": true,
      "queued_steering": 0,
      "queued_follow_ups": 0,
      "provider": "fake",
      "model": null,
      "mode": "build",
      "last_session": null
    },
    "interaction": {
      "status": "idle",
      "current_command_id": null,
      "current_command_type": null,
      "pending_approval_call_id": null,
      "pending_trust_request_id": null,
      "cancel_requested": false,
      "exit_requested": false
    },
    "retained_text": "hello world"
  }
}
