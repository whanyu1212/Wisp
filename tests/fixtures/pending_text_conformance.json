      "actions": [
        { "type": "append", "hex": "6f6e650d" },
        { "type": "append", "hex": "58" },
        {
          "type": "drain",
          "expected": {
            "text": "X",
            "dropped_bytes": 4,
            "retained_source_bytes": 1,
            "source_byte_lengths": [1]
          }
        }
      ]
    },
