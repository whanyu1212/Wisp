    },
    {
      "name": "drain_resets_pending_carriage_return",
      "max_bytes": 100,
      "max_lines": 10,
      "actions": [
        { "type": "append", "hex": "610d" },
        {
          "type": "drain",
          "expected": {
            "text": "a\r",
            "dropped_bytes": 0,
            "retained_source_bytes": 2,
            "source_byte_lengths": [1, 1]
          }
        },
        { "type": "append", "hex": "0a62" },
        {
          "type": "drain",
          "expected": {
            "text": "\nb",
            "dropped_bytes": 0,
            "retained_source_bytes": 2,
            "source_byte_lengths": [1, 1]
          }
        }
      ]
