{
  "version": 1,
  "cases": [
    {
      "name": "empty_and_repeated_noop_drains",
      "max_bytes": 100,
      "max_lines": 10,
      "actions": [
        {
          "type": "drain",
          "expected": {
            "text": "",
            "dropped_bytes": 0,
            "retained_source_bytes": 0,
            "source_byte_lengths": []
          }
        },
        { "type": "append", "hex": "" },
        {
          "type": "drain",
          "expected": {
            "text": "",
            "dropped_bytes": 0,
            "retained_source_bytes": 0,
            "source_byte_lengths": []
          }
        }
      ]
    },
    {
      "name": "ascii_at_exact_byte_cap",
      "max_bytes": 5,
      "max_lines": 10,
      "actions": [
        { "type": "append", "hex": "68656c6c6f" },
        {
          "type": "drain",
          "expected": {
            "text": "hello",
            "dropped_bytes": 0,
            "retained_source_bytes": 5,
            "source_byte_lengths": [1, 1, 1, 1, 1]
          }
        }
      ]
    },
    {
      "name": "ascii_over_byte_cap",
      "max_bytes": 5,
      "max_lines": 10,
      "actions": [
        { "type": "append", "hex": "616263646566" },
        {
          "type": "drain",
          "expected": {
            "text": "bcdef",
            "dropped_bytes": 1,
            "retained_source_bytes": 5,
            "source_byte_lengths": [1, 1, 1, 1, 1]
          }
        }
      ]
    },
    {
      "name": "logical_line_tail",
      "max_bytes": 100,
      "max_lines": 2,
      "actions": [
        { "type": "append", "hex": "6f6e650a74776f0a7468726565" },
        {
          "type": "drain",
          "expected": {
            "text": "two\nthree",
            "dropped_bytes": 4,
            "retained_source_bytes": 9,
            "source_byte_lengths": [1, 1, 1, 1, 1, 1, 1, 1, 1]
          }
        }
      ]
    },
    {
      "name": "all_splitlines_separators",
      "max_bytes": 100,
      "max_lines": 3,
      "actions": [
        {
          "type": "append",
          "hex": "610a620b630c641c651d661e67c28568e280a869e280a97461696c"
        },
        {
          "type": "drain",
          "expected": {
            "text": "h\u2028i\u2029tail",
            "dropped_bytes": 15,
            "retained_source_bytes": 12,
            "source_byte_lengths": [1, 3, 1, 3, 1, 1, 1, 1]
          }
        }
      ]
    },
    {
      "name": "each_splitlines_separator_enforces_line_cap",
      "max_bytes": 100,
      "max_lines": 1,
      "actions": [
        { "type": "append", "hex": "610a62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "610d62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "610b62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "610c62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "611c62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "611d62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "611e62" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 2, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "61c28562" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 3, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "61e280a862" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 4, "retained_source_bytes": 1, "source_byte_lengths": [1] } },
        { "type": "append", "hex": "61e280a962" },
        { "type": "drain", "expected": { "text": "b", "dropped_bytes": 4, "retained_source_bytes": 1, "source_byte_lengths": [1] } }
      ]
    },
    {
      "name": "split_crlf_is_one_boundary",
      "max_bytes": 100,
      "max_lines": 2,
      "actions": [
        { "type": "append", "hex": "6f6e650d" },
        { "type": "append", "hex": "0a74776f" },
        {
          "type": "drain",
          "expected": {
            "text": "one\r\ntwo",
            "dropped_bytes": 0,
            "retained_source_bytes": 8,
            "source_byte_lengths": [1, 1, 1, 1, 1, 1, 1, 1]
          }
        }
      ]
    },
