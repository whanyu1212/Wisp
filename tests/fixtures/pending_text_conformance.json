    {
      "name": "pending_utf8_survives_drain",
      "max_bytes": 100,
      "max_lines": 10,
      "actions": [
        { "type": "append", "hex": "f09f" },
        {
          "type": "drain",
          "expected": {
            "text": "",
            "dropped_bytes": 0,
            "retained_source_bytes": 0,
            "source_byte_lengths": []
          }
        },
        { "type": "append", "hex": "9982" },
        {
          "type": "drain",
          "expected": {
            "text": "🙂",
            "dropped_bytes": 0,
            "retained_source_bytes": 4,
            "source_byte_lengths": [4]
          }
        }
