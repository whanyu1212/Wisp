---
import { Code } from "astro:components";
import { href } from "../content/paths";
import TuiCapture from "./TuiCapture.astro";

const views = [
  {
    id: "editing",
    label: "Editing",
    capture: "sessionEditing" as const,
    summary:
      "Inline syntax-highlighted diffs, codemode calls, captured browser previews, context sparkline, and the two-row telemetry deck.",
    linkLabel: "Explore the terminal workspace",
    route: "guide/tui.html",
    eager: true,
  },
  {
    id: "files",
    label: "Files",
    capture: "sessionFiles" as const,
    summary:
      "Filter the project tree in the docked side panel with Nerd Font icons, read-only inline previews, and one-key editor handoff.",
    linkLabel: "Side panel guide",
    route: "guide/tui.html#side-panel",
    eager: false,
  },
  {
    id: "browser",
    label: "Browser",
    capture: "sessionBrowser" as const,
    summary:
      "Open a live Chrome/Chromium tab right inside the terminal to inspect web apps, preview HTML mockups, or take over interactively.",
    linkLabel: "Browser viewport & takeover",
    route: "guide/tui/commands.html#browser-viewport-and-interactive-takeover",
    eager: false,
  },
  {
    id: "permissions",
    label: "Permissions",
    capture: "sessionPermissions" as const,
    summary:
      "Keep project trust and tool approval separate—choose Ask, Auto edits, macOS sandboxed Auto commands, saved prefix rules, or YOLO.",
    linkLabel: "Tools & safety model",
    route: "guide/tools-and-safety.html",
    eager: false,
  },
];

const pillars = [
  {
    eyebrow: "01 / Try Wisp",
    title: "Explore the terminal workspace",
    summary:
      "Editing turns, turn-scoped /diff (Alt+G), Session | Files | Browser side panel, local ! shell, and live steering.",
    route: "guide/tui.html",
  },
  {
    eyebrow: "02 / Build an agent",
    title: "Crafting Coding Agents · Part I",
    summary:
      "Five runnable stdlib-only Python chapters from a tiny model-tool loop to controlled side effects, paired with Wisp's real trade-offs.",
    route: "crafting-agents/index.html",
  },
  {
    eyebrow: "03 / Inspect the evidence",
    title: "Inside Wisp & evals",
    summary:
      "One typed runtime across every interface, SWE-bench Pro V2 pilot receipts, interruption invariants, protocol fuzzing, and 50k hydration benchmarks.",
    route: "architecture/index.html",
  },
];

const secondaryLinks = [
  { label: "Reference", route: "reference/index.html" },
  { label: "Development", route: "contributing/index.html" },
];
---

<section class="home-intro" aria-labelledby="wisp">
  <div class="home-hero-copy">
    <div class="eyebrow">Personal software · Python &amp; Rust · MIT</div>
    <h1 id="wisp" class="display-title">
      Wisp
    </h1>
    <p class="lede">
      A terminal coding agent I build for daily work—and for the sheer fun of
      tinkering with agent runtimes from the loop up. Written in Python and
      Rust, shared openly to run, read, or build on.
    </p>
    <div class="hero-actions">
      <a class="primary" href={href("guide/quickstart.html")}>
        Try Wisp →
      </a>
      <a class="secondary-action" href={href("crafting-agents/index.html")}>
        Build an agent from scratch
      </a>
    </div>
  </div>
  <section class="home-install" aria-labelledby="install-wisp">
    <div class="home-install-head">
      <h2 id="install-wisp">Install Wisp</h2>
      <a href={href("guide/installation.html")}>Other installations →</a>
    </div>
    <Code
      code={"uv tool install --python 3.12 wisp-ai\ncd path/to/project\nwisp"}
      lang="bash"
      tabindex="0"
      aria-label="Install and start Wisp"
      themes={{ light: "github-light-high-contrast", dark: "github-dark" }}
    />
    <p class="install-note">
      Python 3.11+ supported; 3.12 recommended for installation. Prebuilt native
      TUI wheels: macOS arm64 and Linux x86_64 (glibc 2.28+).
    </p>
  </section>
</section>

<section class="home-showcase" aria-labelledby="work-with-wisp">
  <div class="workspace-stage">
    {views.map((view, index) => (
      <input
        class="stage-radio"
        type="radio"
        name="workspace-view"
        id={`stage-${view.id}`}
        checked={index === 0}
      />
    ))}
    <div class="stage-bar">
      <h2 id="work-with-wisp" class="stage-heading">
        Inside a live session
      </h2>
      <div class="stage-controls">
        <div class="stage-tabs" role="tablist" aria-label="Workspace views">
          {views.map((view) => (
            <label
              class="stage-tab"
              for={`stage-${view.id}`}
              data-stage={view.id}
            >
              <span>{view.label}</span>
              <span class="stage-tab-progress" aria-hidden="true" />
            </label>
          ))}
        </div>
        <button
          type="button"
          class="stage-toggle"
          aria-pressed="false"
          aria-label="Pause workspace slideshow"
          hidden
        >
          Pause
        </button>
      </div>
    </div>
    <div class="stage-panels">
      {views.map((view) => (
        <div class="stage-panel" data-stage={view.id}>
          <TuiCapture
            capture={view.capture}
            eager
            compact
            sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1136px) calc(100vw - 56px), 1080px"
          />
          <div class="stage-foot">
            <p>{view.summary}</p>
            <a class="workflow-link" href={href(view.route)}>
              {view.linkLabel} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>(".workspace-stage");
  const radios = stage
    ? [...stage.querySelectorAll<HTMLInputElement>(".stage-radio")]
    : [];
  const toggle = stage?.querySelector<HTMLButtonElement>(".stage-toggle");
  if (stage && radios.length > 1 && toggle) {
    const INTERVAL_MS = 3800;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let userPaused = reducedMotion.matches;
    let pointerInside = false;
    let focusInside = false;
    let timer: number | undefined;

    const isPaused = () =>
      userPaused || pointerInside || focusInside || document.hidden;

    const restartProgress = () => {
      stage.dataset.cycle = String((Number(stage.dataset.cycle) || 0) + 1);
      for (const bar of stage.querySelectorAll<HTMLElement>(
        ".stage-tab-progress",
      )) {
        bar.style.animation = "none";
        void bar.offsetWidth;
        bar.style.animation = "";
      }
    };

    const sync = () => {
      const paused = isPaused();
      stage.dataset.autoplay = "true";
      stage.dataset.paused = paused ? "true" : "false";
      toggle.hidden = false;
      toggle.textContent = userPaused ? "Play" : "Pause";
      toggle.setAttribute("aria-pressed", userPaused ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        userPaused ? "Play workspace slideshow" : "Pause workspace slideshow",
      );
      if (timer !== undefined) {
        window.clearTimeout(timer);
        timer = undefined;
      }
      if (!paused) {
        timer = window.setTimeout(() => {
          const current = radios.findIndex((r) => r.checked);
          const next = (current + 1) % radios.length;
          radios[next]!.checked = true;
          restartProgress();
          sync();
        }, INTERVAL_MS);
      }
    };

    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      if (!userPaused) restartProgress();
      sync();
    });
    for (const radio of radios) {
      radio.addEventListener("change", () => {
        restartProgress();
        sync();
      });
    }
    stage.addEventListener("pointerenter", () => {
      pointerInside = true;
      sync();
    });
    stage.addEventListener("pointerleave", () => {
      pointerInside = false;
      restartProgress();
      sync();
    });
    stage.addEventListener("focusin", () => {
      focusInside = true;
      sync();
    });
    stage.addEventListener("focusout", (event) => {
      if (!stage.contains(event.relatedTarget as Node | null)) {
        focusInside = false;
        restartProgress();
        sync();
      }
    });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) restartProgress();
      sync();
    });
    reducedMotion.addEventListener("change", (event) => {
      if (event.matches) userPaused = true;
      sync();
    });

    restartProgress();
    sync();
  }
</script>

<section class="home-section" aria-labelledby="choose-a-starting-point">
  <div class="home-section-head">
    <div class="eyebrow">Explore the docs</div>
    <h2 id="choose-a-starting-point">Where to go next</h2>
  </div>
  <div class="starting-points">
    {pillars.map((pillar) => (
      <a class="starting-card" href={href(pillar.route)}>
        <span class="eyebrow">{pillar.eyebrow}</span>
        <strong>{pillar.title} →</strong>
        <p>{pillar.summary}</p>
      </a>
    ))}
  </div>
</section>

<section class="home-story" aria-labelledby="why-wisp">
  <div class="home-story-body">
    <div class="eyebrow">Why I build this</div>
    <h2 id="why-wisp">Built for daily use, shared for the fun of it</h2>
    <p>
      I started Wisp because the best way to understand coding agents is to
      build one you actually live in every day. The Python runtime, the native
      Rust terminal UI, the safety boundaries, and the{" "}
      <a href={href("crafting-agents/index.html")}>Crafting Coding Agents</a>{" "}
      book all grew out of having a blast exploring how the pieces fit together.
    </p>
    <p>
      Because it is personal software, it evolves freely without much ceremony.
      Everything is{" "}
      <a href="https://github.com/whanyu1212/Wisp">MIT-licensed on GitHub</a>
      —take it for a spin, read the internals, borrow an idea, or fork it into
      something of your own.
    </p>
  </div>
  <dl class="home-highlights">
    <div>
      <dt>One shared runtime</dt>
      <dd>
        The Rust TUI, print CLI, JSONL RPC, and Python SDK all drive the same
        typed engine and append-only session log.
      </dd>
    </div>
    <div>
      <dt>A runnable book alongside the code</dt>
      <dd>
        Every chapter in{" "}
        <a href={href("crafting-agents/index.html")}>Crafting Coding Agents</a>{" "}
        pairs a standalone Python checkpoint with Wisp's real trade-offs.
      </dd>
    </div>
    <div>
      <dt>Made to stay in sync</dt>
      <dd>
        Steer active runs, queue follow-ups, review per-turn diffs, and keep
        project trust separate from per-call approval.
      </dd>
    </div>
  </dl>
</section>

<section class="home-content" aria-labelledby="start-reading">
  <div class="home-content-copy">
    <h2 id="start-reading">Keep poking around</h2>
    <p>
      Run Wisp interactively in the terminal, script one-shot runs in print
      mode, talk to it over JSONL RPC, or embed it from Python. Browse{" "}
      <a href={href("guide/interfaces.html")}>all interfaces</a>,{" "}
      <a href={href("guide/sdk.html")}>embed Wisp</a>, or read the{" "}
      <a href={href("changelog.html")}>release notes</a>.
    </p>
  </div>
  <div class="secondary-starts">
    {secondaryLinks.map((item) => (
      <a href={href(item.route)}>{item.label} →</a>
    ))}
  </div>
</section>
