---
import { Image } from "astro:assets";
import { tuiCaptures, type TuiCapture } from "../content/tui-captures";
interface Props {
  capture: TuiCapture;
  eager?: boolean;
  /** Omit the long description when surrounding copy already explains the frame. */
  compact?: boolean;
  /** How wide the figure renders, for choosing among the generated widths. */
  sizes?: string;
}
const {
  capture,
  eager = false,
  compact = false,
  sizes = "(max-width: 760px) 100vw, 760px",
} = Astro.props;
const entry = tuiCaptures[capture];
const { image, alt, caption } = entry;
const provenance =
  "provenance" in entry
    ? entry.provenance
    : "Production TUI renderer · synthetic demo data · static capture.";
---

<figure class="tui-capture">
  <a href={image.src} aria-label={`Open full-size capture: ${alt}`}>
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1600, 2400]}
      sizes={sizes}
      format="webp"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </a>
  <figcaption>
    {compact ? (
      <span class="capture-provenance capture-provenance-only">
        {provenance} Open the image for full size.
      </span>
    ) : (
      <>
        {caption}{" "}
        <span class="capture-provenance">
          {provenance} Open the image for full size.
        </span>
      </>
    )}
  </figcaption>
</figure>
