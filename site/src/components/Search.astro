---
import { href } from "../content/paths";
---

<button
  type="button"
  id="search-open"
  aria-haspopup="dialog"
  aria-label="Search documentation"
  hidden
>
  Search
</button>
<dialog
  id="search-dialog"
  class="search-dialog"
  aria-labelledby="search-title"
  data-pagefind-ignore="all"
  data-search-bundle={href("pagefind/pagefind.js")}
>
  <div class="search-heading">
    <h2 id="search-title">Search documentation</h2>
    <button type="button" id="search-close">
      Close
    </button>
  </div>
  <form role="search" id="search-form">
    <label for="search-query">Search guides, reference, and lessons</label>
    <div class="search-field">
      <input
        id="search-query"
        type="search"
        autocomplete="off"
        autofocus
        aria-describedby="search-status"
      />
      <button type="submit">Search</button>
    </div>
  </form>
  <p id="search-status" role="status" aria-live="polite" aria-atomic="true">
    Type to search the documentation.
  </p>
  <ol id="search-results" aria-label="Search results"></ol>
  <button type="button" id="search-more" hidden>
    Load more results
  </button>
</dialog>
<script>
  import "./search";
</script>
