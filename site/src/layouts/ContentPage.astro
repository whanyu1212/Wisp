---
import { render, type CollectionEntry } from "astro:content";
import Home from "../components/Home.astro";
import SectionIndex from "../components/SectionIndex.astro";
import TuiCapture from "../components/TuiCapture.astro";
import Document from "./Document.astro";
import { href, base } from "../content/paths";
import type { Heading } from "../content/render";
const tuiSource = "guide/tui.md";

interface Props {
  entry: CollectionEntry<"pages"> | CollectionEntry<"maintainerRecords">;
  compatibility: boolean;
}
const { entry, compatibility } = Astro.props;
const { Content, headings } = await render(entry);
const target = href(entry.data.route);
---

<Document
  page={entry.data}
  headings={compatibility ? [] : (headings as Heading[])}
  compatibility={compatibility}
>
  {compatibility ? (
    <>
      <h1>{entry.data.title} has moved</h1>
      <p>
        <a id="destination" href={target}>
          Continue to {entry.data.title} →
        </a>
      </p>
      <p>If automatic navigation is unavailable, choose a section below.</p>
      <ul>
        {headings.map((heading) => (
          <li id={heading.slug}>
            <a href={`${target}#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
      <script is:inline define:vars={{ target, base }}>
        const destination = target + location.search + location.hash;
        document.getElementById("destination").href = destination;
        if (target.startsWith(base)) location.replace(destination);
      </script>
    </>
  ) : entry.data.layout === "home" ? (
    <Home />
  ) : (
    <article>
      <Content />
      {[
        "guide/index.md",
        "reference/index.md",
        "contributing/index.md",
      ].includes(entry.data.source) && <SectionIndex page={entry.data} />}
      {entry.data.capture && <TuiCapture capture={entry.data.capture} />}
      {entry.data.source === tuiSource && <script>
        function navigateTuiSection() {
          let id: string;
          try {
            id = decodeURIComponent(location.hash.slice(1));
          } catch {
            return;
          }
          const link = document
            .getElementById(id)
            ?.querySelector<HTMLAnchorElement>("a[data-tui-destination]");
          if (link) {
            const target = new URL(link.href);
            target.search = location.search;
            location.replace(target.href);
          }
        }
        navigateTuiSection();
        window.addEventListener("hashchange", navigateTuiSection);
      </script>}
      {entry.data.source === "contributing/index.md" && (
        <section aria-labelledby="release-records">
          <h2 id="release-records">Release records</h2>
          <p>
            Read the <a href={href("changelog.html")}>Changelog</a> for
            user-facing changes. Maintainers can browse the{" "}
            <a href={href("maintainers/releases/index.html")}>
              release record archive
            </a>
            for historical decisions, verification evidence, and checklists.
          </p>
        </section>
      )}
    </article>
  )}
</Document>
