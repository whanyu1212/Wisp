---
import { getCollection } from "astro:content";
import { href } from "../content/paths";
import { ancestors, navigation } from "../content/navigation";
import { changelog, sections, type PageMetadata } from "../content/metadata";
import type { Heading } from "../content/render";
import Diagrams from "../components/Diagrams.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Theme from "../components/Theme.astro";
import CodeBlocks from "../components/CodeBlocks.astro";
import "../styles/site.css";
interface Props {
  page: PageMetadata;
  headings?: Heading[];
  compatibility?: boolean;
  editSource?: string;
}
const { page, headings = [], compatibility = false, editSource } = Astro.props;
const pages = (await getCollection("pages")).map((entry) => entry.data);
const groups = navigation(pages);
const current = groups.find((group) => group.key === page.section);
const siblings = current?.pages ?? [];
const index = siblings.findIndex((item) => item.source === page.source);
const previous = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 ? siblings[index + 1] : undefined;
const root = siblings[0];
const breadcrumbs = ancestors(page, pages);
if (
  root &&
  root.source !== page.source &&
  !breadcrumbs.some((item) => item.source === root.source)
)
  breadcrumbs.unshift(root);
const toc = headings.filter(
  (heading) => heading.depth > 1 && heading.depth < 4,
);
const course = page.layout === "course";
const caseStudy = course && !page.chapter && page.source !== root?.source;
const hasToc = toc.length > 0 && page.layout !== "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="wisp-docs-revision"
      content={process.env.GITHUB_SHA ?? "local"}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description} />
    {page.searchable && !compatibility && (
      <>
        <meta data-pagefind-meta="title[content]" content={page.title} />
        <meta
          data-pagefind-meta="section[content]"
          content={sections[page.section]}
        />
      </>
    )}
    <title>{page.title === 'Wisp' ? 'Wisp — a coding agent you can steer' : `${page.title} · Wisp`}</title>
    <link rel="canonical" href={new URL(href(page.route), Astro.site)} />
    {(!page.searchable || compatibility) && (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" href={href("assets/favicon.png")} />
    <Theme />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <SiteHeader groups={groups} page={page} />
    <div
      class:list={[
        "page",
        { home: page.layout === "home", course, "no-toc": !hasToc },
      ]}
    >
      {page.layout !== "home" && (
        <aside class="sidebar">
          <nav
            aria-label={
              course ? "Course chapters" : (current?.title ?? "Archive")
            }
          >
            <strong class="sidebar-title">
              {course
                ? "Crafting Coding Agents"
                : (current?.title ?? "Maintainer archive")}
            </strong>
            {siblings.length > 0 ? (
              siblings.map((item) => (
                <>
                  {item.navGroup && (
                    <strong class="nav-group">{item.navGroup}</strong>
                  )}
                  <a
                    href={href(item.route)}
                    style={`--nav-depth: ${item.depth}`}
                    aria-current={
                      item.source === page.source ? "page" : undefined
                    }
                  >
                    {item.navTitle ?? item.title}
                  </a>
                </>
              ))
            ) : (
              <>
                <a
                  href={href("maintainers/releases/index.html")}
                  aria-current={
                    page.route === "maintainers/releases/index.html"
                      ? "page"
                      : undefined
                  }
                >
                  Release record archive
                </a>
                <a href={href(changelog.route)}>Changelog</a>
                <a href={href("contributing/index.html")}>Contributing</a>
              </>
            )}
          </nav>
        </aside>
      )}
      <main
        id="main"
        tabindex="-1"
        data-pagefind-body={page.searchable && !compatibility ? "" : undefined}
      >
        {page.layout !== "home" && (
          <div class="page-meta" data-pagefind-ignore>
            <nav
              class="breadcrumbs"
              aria-label="Breadcrumb"
              data-pagefind-ignore
            >
              <ol>
                <li>
                  <a href={href("index.html")}>Home</a>
                </li>
                {breadcrumbs.map((item) => (
                  <li>
                    <a href={href(item.route)}>{item.navTitle ?? item.title}</a>
                  </li>
                ))}
                <li>
                  <span aria-current="page">{page.navTitle ?? page.title}</span>
                </li>
              </ol>
            </nav>
            <div class="eyebrow" data-pagefind-ignore>
              {page.layout === "archive"
                ? "Maintainer archive · historical record"
                : current?.title}
              {page.chapter
                ? ` / Chapter ${page.chapter}`
                : caseStudy
                  ? " / Case study"
                  : ""}
            </div>
          </div>
        )}
        {hasToc && <TableOfContents headings={toc} mobile />}
        <slot />
        {page.checkpoint && (
          <aside
            class="checkpoint"
            aria-label="Runnable checkpoint"
            data-pagefind-ignore
          >
            <span class="eyebrow">Keep building</span>
            <p>
              <a
                href={`https://github.com/whanyu1212/Wisp/blob/main/${page.checkpoint}`}
              >
                Runnable checkpoint source ↗
              </a>
            </p>
            <code>{page.checkpoint}</code>
          </aside>
        )}
        {page.layout !== "home" && !compatibility && (previous || next) && (
          <nav
            class="previous-next"
            aria-label="Adjacent pages"
            data-pagefind-ignore
          >
            {previous ? (
              <a href={href(previous.route)} rel="prev">
                <span>← Previous</span>
                {previous.navTitle ?? previous.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={href(next.route)} rel="next">
                <span>Next →</span>
                {next.navTitle ?? next.title}
              </a>
            )}
          </nav>
        )}
      </main>
      {hasToc && <TableOfContents headings={toc} />}
    </div>
    <footer class="site-footer">
      <span>One shared runtime. TUI · CLI · RPC · Python SDK.</span>
      <a href={href(changelog.route)}>Changelog</a>
      <a href={href("print.html")}>Print documentation</a>
      <a
        href={`https://github.com/whanyu1212/Wisp/edit/main/${editSource ?? (page.source === changelog.source ? "CHANGELOG.md" : `site/src/content/pages/${page.source}`)}`}
      >
        Edit this page
      </a>
    </footer>
    <CodeBlocks />
    <Diagrams />
  </body>
</html>
