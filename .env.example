# Copy this file to .env and fill in your local secrets.
# Never commit real API keys.

# Optional defaults. CLI flags override these values.
WISP_PROVIDER=fake
WISP_MODEL=

# Optional CLI launch defaults. Leave blank for help/text-mode defaults.
# Set WISP_MODE=tui and WISP_TUI_RENDERER=fullscreen to make `wisp` open the live TUI.
WISP_MODE=
WISP_TUI_RENDERER=

# Optional: persist sessions somewhere durable. Defaults to OS temp storage.
WISP_SESSION_DIR=

# Required only when WISP_PROVIDER=openai or --provider openai is used.
OPENAI_API_KEY=
